rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users collection: /users/{userId}
    function isValidUser(data) {
      return data.id is string && data.id == request.auth.uid &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // 2. Saved Prompts: /savedPrompts/{promptId}
    function isValidSavedPrompt(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.prompt is string && data.prompt.size() > 0 && data.prompt.size() <= 50000 &&
             (!('model' in data) || (data.model is string && data.model.size() <= 64)) &&
             (!('systemInstruction' in data) || (data.systemInstruction is string && data.systemInstruction.size() <= 10000)) &&
             (!('thinkingLevel' in data) || (data.thinkingLevel is string && data.thinkingLevel.size() <= 16)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /savedPrompts/{promptId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(promptId) && isValidSavedPrompt(incoming());
      allow update: if isSignedIn() && isValidId(promptId) && isValidSavedPrompt(incoming()) &&
                       resource.data.userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 3. Game Scores: /gameScores/{scoreId}
    function isValidGameScore(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.score is number && data.score >= 0 && data.score <= 10000000 &&
             (!('userDisplayName' in data) || (data.userDisplayName is string && data.userDisplayName.size() <= 128)) &&
             (!('crystalsCollected' in data) || (data.crystalsCollected is number && data.crystalsCollected >= 0 && data.crystalsCollected <= 100000)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /gameScores/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(scoreId) && isValidGameScore(incoming());
      allow update: if false; // Scores are immutable
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 4. Auto Service Tickets (RAG Diagnostics): /autoServiceTickets/{ticketId}
    function isValidAutoServiceTicket(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.vehicleMake is string && data.vehicleMake.size() > 0 && data.vehicleMake.size() <= 64 &&
             data.vehicleModel is string && data.vehicleModel.size() > 0 && data.vehicleModel.size() <= 64 &&
             data.dtcCode is string && data.dtcCode.size() > 0 && data.dtcCode.size() <= 32 &&
             (!('vehicleYear' in data) || (data.vehicleYear is string && data.vehicleYear.size() <= 16)) &&
             (!('engine' in data) || (data.engine is string && data.engine.size() <= 64)) &&
             (!('symptoms' in data) || (data.symptoms is string && data.symptoms.size() <= 5000)) &&
             (!('diagnosis' in data) || (data.diagnosis is string && data.diagnosis.size() <= 50000)) &&
             (!('repairSteps' in data) || (data.repairSteps is string && data.repairSteps.size() <= 50000)) &&
             (!('torqueSpecs' in data) || (data.torqueSpecs is string && data.torqueSpecs.size() <= 10000)) &&
             (!('sourcesCited' in data) || (data.sourcesCited is string && data.sourcesCited.size() <= 10000)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 32)) &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /autoServiceTickets/{ticketId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(ticketId) && isValidAutoServiceTicket(incoming());
      allow update: if isSignedIn() && isValidId(ticketId) && isValidAutoServiceTicket(incoming()) &&
                       resource.data.userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
